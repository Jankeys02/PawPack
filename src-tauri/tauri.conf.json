{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PawPack",
  "version": "1.0.0",
  "identifier": "com.jankeys.pawpack",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PawPack",
        "width": 1200,
        "height": 760,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENCRjZFMTJCMzA5NjkyNDAKUldSQWtwWXdLK0gyeXhWOGg1TzRLbGZPbTVQR0J1VURtVXZrdFkzOGZHenBYVytWRzNxQmtEWXEK",
      "endpoints": [
        "https://github.com/Jankeys02/PawPack/releases/latest/download/latest.json"
      ]
    }
  }
}
